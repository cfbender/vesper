# Optional env_file for the reference Compose service; use your own path.
# Restrict access to the account running Compose (for example chmod 0600).
# Values here back `{env: NAME}` secret references in the YAML. Anyone who can
# run `docker inspect vesper` can read them; prefer files in secrets/ for
# credentials and use environment values for low-sensitivity identifiers.
VESPER_TELEGRAM_CHAT_ID=CHANGE-ME
