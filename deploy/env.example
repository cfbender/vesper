# Merge into your stack's .env when using deploy/compose.yaml (non-secret values).
# Published GHCR image (linux/amd64). For repeatable deployments, replace latest
# with the pulled ghcr.io/cfbender/vesper@sha256:... digest; see installation.md.
VESPER_IMAGE=ghcr.io/cfbender/vesper:latest
# Optional: existing Traefik authentication middleware (or chain containing it).
# Examples: vesper-auth@file for proxy BasicAuth, authelia@file for Authelia.
# WARNING: empty means NO authentication. Anyone who can reach the dashboard
# has full administrator access. Restrict network access or configure auth.
# See docs/security.md for auth examples. This is a Compose variable, not a Vesper setting.
VESPER_AUTH_MIDDLEWARE=
# Only for optional Docker label discovery (docs/discovery.md): the group that
# owns the Docker socket, from `stat -c %g /var/run/docker.sock`.
# DOCKER_GID=
